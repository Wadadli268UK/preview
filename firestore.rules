rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Site settings - Public read, write allowed for CMS management
    match /site_settings/{docId} {
      allow read: if true;
      allow write: if true;
    }
    // Products catalog - Public read, write allowed for CMS management
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }
    // Made-to-order products - Public read, write allowed for CMS management
    match /made_to_order_products/{productId} {
      allow read: if true;
      allow write: if true;
    }
    // Portfolio case studies - Public read, write allowed for CMS management
    match /portfolio/{projectId} {
      allow read: if true;
      allow write: if true;
    }
    // FAQs - Public read, write allowed for CMS management
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if true;
    }
    // Enquiries & Quote Leads - Public submission and management
    match /enquiries/{enquiryId} {
      allow read: if true;
      allow write: if true;
    }
    // Analytics conversion tracking events
    match /analytics/{eventId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
